# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

command = [
    "npm",
    "run",
    "verify",
]
ro_maps = ["~/.nvm/versions/node/v20.19.6"]
mask = [
    ".env",
    "**/*.env",
    ".env.test",
]
no_gpu = true
no_docker = true
no_display = true
private_home = true
